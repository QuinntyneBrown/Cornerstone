{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/cornerstone",
  "assets": [
    {
      "glob": "**/*.scss",
      "input": "src/styles",
      "output": "styles"
    },
    {
      "glob": "**/*.css",
      "input": "src/styles",
      "output": "styles"
    }
  ],
  "lib": {
    "entryFile": "src/public-api.ts"
  }
}
