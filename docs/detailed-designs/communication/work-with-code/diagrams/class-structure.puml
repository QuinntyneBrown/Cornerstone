@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Work with code

enum CsCodeWrapMode {
  wrap
  scroll
}

enum CsRunState {
  idle
  running
  succeeded
  failed
}

enum CsPreviewKind {
  text
  document
}

enum CsDataState {
  idle
  loading
  ready
  empty
  error
}

class CsCodeBlockComponent {
  +source: InputSignal<string>
  +language: InputSignal<string | null>
  +wrap: InputSignal<CsCodeWrapMode>
  +copyable: InputSignal<boolean>
  +copied: OutputEmitterRef<void>
  +accessibleName: Signal<string>
  +scrollable: Signal<boolean>
}

class CsCopyToClipboardDirective {
  +text: InputSignal<string>
  +copy(): Promise<void>
  -announce(message: string): void
}

class CsCaretPosition {
  +line: number
  +column: number
  +characters: number
}

class CsCaretPositionDirective {
  +position: Signal<CsCaretPosition>
  -recompute(value: string, selectionStart: number): CsCaretPosition
}

class CsRunIntent {
  +source: string
  +language: string | null
}

class CsCodeEditorComponent {
  +value: ModelSignal<string>
  +label: InputSignal<string>
  +language: InputSignal<string | null>
  +readOnly: InputSignal<boolean>
  +runState: InputSignal<CsRunState>
  +runRequested: OutputEmitterRef<CsRunIntent>
  +resetRequested: OutputEmitterRef<void>
  +position: Signal<CsCaretPosition>
  +writeValue(value: string): void
  -escapeTabFocus(event: KeyboardEvent): void
}

class CsPreviewOutput {
  +kind: CsPreviewKind
  +content: string
  +frameTitle: string | null
  +errorMessage: string | null
}

class CsPreviewPaneComponent {
  +output: InputSignal<CsPreviewOutput>
  +state: InputSignal<CsDataState>
  +retryRequested: OutputEmitterRef<void>
  -sandboxTokens(): string
}

interface ControlValueAccessor {
  +writeValue(value: unknown): void
  +registerOnChange(fn: (value: unknown) => void): void
  +setDisabledState(isDisabled: boolean): void
}

class CsConfirmDialogComponent {
  +title: InputSignal<string>
  +destructive: InputSignal<boolean>
  +confirmed: OutputEmitterRef<void>
}

CsCodeEditorComponent ..|> ControlValueAccessor
CsCodeEditorComponent *-- CsCaretPositionDirective
CsCodeEditorComponent --> CsRunState : has
CsCodeEditorComponent --> CsRunIntent : emits
CsCodeEditorComponent ..> CsConfirmDialogComponent : presents before reset
CsCaretPositionDirective --> CsCaretPosition : exposes
CsCodeBlockComponent *-- CsCopyToClipboardDirective
CsCodeBlockComponent --> CsCodeWrapMode : has
CsPreviewPaneComponent ..> CsCodeBlockComponent : renders text output through
CsPreviewPaneComponent --> CsPreviewOutput : renders
CsPreviewPaneComponent --> CsDataState : has
CsPreviewOutput --> CsPreviewKind : has
@enduml
