@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Hold a conversation

enum CsMessageKind {
  sent
  received
  system
}

enum CsDeliveryState {
  queued
  sending
  delivered
  read
  failed
}

enum CsSendState {
  idle
  sending
  queued
  error
}

enum CsDataState {
  idle
  loading
  ready
  empty
  error
}

class CsMessageViewModel {
  +id: string
  +conversationId: string
  +authorName: string
  +authorAvatarUrl: string | null
  +sentAt: string
  +body: string
  +kind: CsMessageKind
  +delivery: CsDeliveryState
  +readAt: string | null
}

class CsThreadAssignment {
  +assigned: boolean
  +participantName: string | null
}

class CsMessageThreadComponent {
  +messages: InputSignal<readonly CsMessageViewModel[]>
  +state: InputSignal<CsDataState>
  +assignment: InputSignal<CsThreadAssignment>
  +historyRequested: OutputEmitterRef<CsHistoryRequest>
  +retryRequested: OutputEmitterRef<CsMessageRetryIntent>
  +newMessagesActivated: OutputEmitterRef<void>
  +hasUnseenBelow: Signal<boolean>
}

class CsThreadScrollAnchor {
  +pinnedToBottom: Signal<boolean>
  +capture(): CsScrollSnapshot
  +restore(snapshot: CsScrollSnapshot): void
  -isNearBottom(threshold: number): boolean
}

class CsScrollSnapshot {
  +anchorMessageId: string | null
  +anchorOffset: number
  +wasPinned: boolean
}

class CsThreadAnnouncerService {
  +announceAppended(message: CsMessageViewModel): void
  +suppressPrepended(ids: readonly string[]): void
  -announcedIds: Set<string>
}

class CsHistoryRequest {
  +conversationId: string
  +before: string
}

class CsMessageRetryIntent {
  +conversationId: string
  +messageId: string
}

class CsSendIntent {
  +conversationId: string
  +body: string
  +attachmentIds: readonly string[]
}

class CsComposerAttachment {
  +id: string
  +name: string
  +sizeBytes: number
}

class CsMessageComposerComponent {
  +value: ModelSignal<string>
  +maxLength: InputSignal<number>
  +attachments: InputSignal<readonly CsComposerAttachment[]>
  +sendState: InputSignal<CsSendState>
  +offline: InputSignal<boolean>
  +send: OutputEmitterRef<CsSendIntent>
  +retry: OutputEmitterRef<CsSendIntent>
  +attachmentRemoved: OutputEmitterRef<string>
  +canSend: Signal<boolean>
  +writeValue(value: string): void
}

class CsConversationViewModel {
  +id: string
  +title: string
  +avatarUrl: string | null
  +preview: string
  +lastMessageAt: string
  +unreadCount: number
}

class CsConversationListComponent {
  +conversations: InputSignal<readonly CsConversationViewModel[]>
  +selectedId: ModelSignal<string | null>
  +state: InputSignal<CsDataState>
  +conversationSelected: OutputEmitterRef<string>
  +detailOnly: Signal<boolean>
}

class CsConversationItemComponent {
  +conversation: InputSignal<CsConversationViewModel>
  +selected: InputSignal<boolean>
  +activated: OutputEmitterRef<string>
}

interface ControlValueAccessor {
  +writeValue(value: unknown): void
  +registerOnChange(fn: (value: unknown) => void): void
  +setDisabledState(isDisabled: boolean): void
}

CsMessageComposerComponent ..|> ControlValueAccessor
CsMessageThreadComponent *-- CsThreadScrollAnchor
CsMessageThreadComponent *-- CsThreadAnnouncerService
CsMessageThreadComponent "1" o-- "0..*" CsMessageViewModel
CsMessageThreadComponent --> CsThreadAssignment : has
CsMessageThreadComponent --> CsDataState : has
CsMessageThreadComponent --> CsHistoryRequest : emits
CsMessageThreadComponent --> CsMessageRetryIntent : emits
CsThreadScrollAnchor ..> CsScrollSnapshot : captures
CsThreadAnnouncerService ..> CsMessageViewModel : reads
CsMessageViewModel --> CsMessageKind : has
CsMessageViewModel --> CsDeliveryState : has
CsMessageComposerComponent --> CsSendState : has
CsMessageComposerComponent --> CsSendIntent : emits
CsMessageComposerComponent "1" o-- "0..*" CsComposerAttachment
CsConversationListComponent ..> CsConversationItemComponent : renders
CsConversationListComponent "1" o-- "0..*" CsConversationViewModel
CsConversationItemComponent ..> CsConversationViewModel : renders
@enduml
