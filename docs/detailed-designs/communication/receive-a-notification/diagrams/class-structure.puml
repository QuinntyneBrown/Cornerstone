@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Receive a notification

enum CsNotificationCategory {
  message
  assignment
  event
  system
  achievement
}

enum CsDataState {
  idle
  loading
  ready
  empty
  error
}

enum CsSubmitState {
  idle
  pending
  succeeded
  failed
}

enum CsDeliveryMode {
  now
  scheduled
}

enum CsAudienceKind {
  cohort
  role
  individual
}

class CsNotificationViewModel {
  +id: string
  +category: CsNotificationCategory
  +title: string
  +body: string
  +occurredAt: string
  +read: boolean
  +link: CsDeepLinkTarget | null
}

class CsDeepLinkTarget {
  +route: string
  +params: Readonly<Record<string, string>>
}

class CsNotificationNavigateIntent {
  +notificationId: string
  +target: CsDeepLinkTarget
}

class CsNotificationListComponent {
  +notifications: InputSignal<readonly CsNotificationViewModel[]>
  +state: InputSignal<CsDataState>
  +unreadCount: InputSignal<number>
  +markRead: OutputEmitterRef<string>
  +markAllRead: OutputEmitterRef<void>
  +navigate: OutputEmitterRef<CsNotificationNavigateIntent>
  +canMarkAll: Signal<boolean>
}

class CsNotificationItemComponent {
  +notification: InputSignal<CsNotificationViewModel>
  +readToggled: OutputEmitterRef<string>
  +activated: OutputEmitterRef<CsNotificationNavigateIntent>
  +accessibleName: Signal<string>
}

class CsAudienceOption {
  +id: string
  +label: string
  +kind: CsAudienceKind
  +recipientCount: number
}

class CsAnnouncementDraft {
  +audienceIds: readonly string[]
  +delivery: CsDeliveryMode
  +scheduledAt: string | null
  +subject: string
  +body: string
}

class CsAnnouncementComposerComponent {
  +audiences: InputSignal<readonly CsAudienceOption[]>
  +value: ModelSignal<CsAnnouncementDraft>
  +submitState: InputSignal<CsSubmitState>
  +previewHtml: InputSignal<string | null>
  +submitted: OutputEmitterRef<CsAnnouncementDraft>
  +previewRequested: OutputEmitterRef<CsAnnouncementDraft>
  +scheduleRequired: Signal<boolean>
  -validateFutureInstant(value: string): CsValidationError | null
}

class CsValidationError {
  +controlName: string
  +message: string
}

class CsValidationSummaryComponent {
  +errors: InputSignal<readonly CsValidationError[]>
  +focusFirstInvalid(): void
}

CsNotificationListComponent "1" o-- "0..*" CsNotificationViewModel
CsNotificationListComponent ..> CsNotificationItemComponent : renders
CsNotificationListComponent --> CsDataState : has
CsNotificationListComponent --> CsNotificationNavigateIntent : emits
CsNotificationItemComponent ..> CsNotificationViewModel : renders
CsNotificationItemComponent --> CsNotificationNavigateIntent : emits
CsNotificationViewModel --> CsNotificationCategory : has
CsNotificationViewModel "1" o-- "0..1" CsDeepLinkTarget
CsNotificationNavigateIntent --> CsDeepLinkTarget : carries
CsAnnouncementComposerComponent "1" o-- "0..*" CsAudienceOption
CsAnnouncementComposerComponent --> CsAnnouncementDraft : holds
CsAnnouncementComposerComponent --> CsSubmitState : has
CsAnnouncementComposerComponent *-- CsValidationSummaryComponent
CsAnnouncementDraft --> CsDeliveryMode : has
CsAudienceOption --> CsAudienceKind : has
CsValidationSummaryComponent "1" o-- "0..*" CsValidationError
@enduml
