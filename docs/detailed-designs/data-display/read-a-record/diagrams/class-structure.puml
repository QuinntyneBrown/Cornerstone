@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Read a record

enum CsListDensity {
  compact
  comfortable
}

enum CsListSelectionMode {
  none
  single
  multiple
}

enum CsListItemInteraction {
  static
  link
  selectable
}

class CsListComponent {
  +dividers: InputSignal<boolean>
  +density: InputSignal<CsListDensity>
  +selectionMode: InputSignal<CsListSelectionMode>
  +state: InputSignal<CsDataState<void>>
  +selectionChange: OutputEmitterRef<ReadonlySet<string>>
  -keyManager: ListKeyManager<CsListItemComponent>
  -role: Signal<string>
}

class CsListItemComponent {
  +key: InputSignal<string>
  +title: InputSignal<string>
  +meta: InputSignal<string | null>
  +interaction: InputSignal<CsListItemInteraction>
  +selected: ModelSignal<boolean>
  +unread: InputSignal<boolean>
  +disabled: InputSignal<boolean>
  +activated: OutputEmitterRef<void>
}

class CsDefinitionListComponent {
  +items: InputSignal<CsDefinitionItem[]>
  +layout: InputSignal<CsDefinitionLayout>
  +state: InputSignal<CsDataState<void>>
}

class CsDefinitionItem {
  +term: string
  +value: string | null
  +emptyText?: string
}

enum CsDefinitionLayout {
  inline
  stacked
  compact
}

class CsTimelineComponent {
  +entries: InputSignal<CsTimelineEntry[]>
  +variant: InputSignal<CsTimelineVariant>
  +state: InputSignal<CsDataState<void>>
  +entryActivated: OutputEmitterRef<CsTimelineEntryRef>
}

class CsTimelineEntry {
  +key: string
  +title: string
  +date: string
  +position: CsTimelinePosition
  +meta?: string
  +description?: string
}

enum CsTimelinePosition {
  past
  current
  future
}

enum CsTimelineVariant {
  vertical
  compact
}

class CsScriptureQuoteComponent {
  +citation: InputSignal<string | null>
  +reference: InputSignal<string | null>
  +surface: InputSignal<CsQuoteSurface>
  +size: InputSignal<CsQuoteSize>
}

enum CsQuoteSurface {
  light
  dark
}

class CsTooltipDirective {
  +csTooltip: InputSignal<string>
  +position: InputSignal<CsTooltipPosition>
  +showDelay: InputSignal<number>
  +hideDelay: InputSignal<number>
  +disabled: InputSignal<boolean>
  +show(): void
  +hide(): void
  -fallbacksFor(position: CsTooltipPosition): ConnectedPosition[]
}

enum CsTooltipPosition {
  above
  below
  before
  after
}

interface CsDataState<T> {
  +kind: CsDataStateKind
}

CsListComponent *-- "0..*" CsListItemComponent : contains
CsListComponent --> CsListDensity : has
CsListComponent --> CsListSelectionMode : has
CsListComponent ..> CsDataState : renders states of
CsListItemComponent --> CsListItemInteraction : has
CsDefinitionListComponent --> "0..*" CsDefinitionItem : renders
CsDefinitionListComponent --> CsDefinitionLayout : has
CsDefinitionListComponent ..> CsDataState : renders states of
CsTimelineComponent --> "0..*" CsTimelineEntry : renders
CsTimelineComponent --> CsTimelineVariant : has
CsTimelineComponent ..> CsDataState : renders states of
CsTimelineEntry --> CsTimelinePosition : has
CsScriptureQuoteComponent --> CsQuoteSurface : has
CsTooltipDirective --> CsTooltipPosition : prefers
CsListItemComponent ..> CsTooltipDirective : may carry on a trailing action
CsDefinitionListComponent ..> CsTooltipDirective : may carry on an abbreviated value
@enduml
