@startuml
' --- shared skin header ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
' --------------------------
title Class structure — Open a drawer

enum CsDrawerPosition {
  start
  end
  bottom
}

enum CsDrawerMode {
  modal
  nonModal
}

class CsDrawerComponent {
  +opened: ModelSignal<boolean>
  +position: InputSignal<CsDrawerPosition>
  +mode: InputSignal<CsDrawerMode>
  +size: InputSignal<string>
  +responsiveFullScreen: InputSignal<boolean>
  +dismissible: InputSignal<boolean>
  +openedChange: OutputEmitterRef<boolean>
  +closed: OutputEmitterRef<void>
  -effectiveMode: Signal<CsDrawerMode>
  -previouslyFocused: HTMLElement
  +open(): void
  +close(): void
  -engageTrap(): void
  -releaseTrap(): void
}

class CsDrawerContainerComponent {
  +drawer: Signal<CsDrawerComponent>
  +contentInset: Signal<string>
}

class CsDrawerConfig<D> {
  +data: D
  +position: CsDrawerPosition
  +mode: CsDrawerMode
  +size: string
  +responsiveFullScreen: boolean
  +dismissible: boolean
  +restoreFocus: boolean
  +ariaLabelledBy: string
}

class CsDrawerService {
  -overlay: Overlay
  +open<R, D, C>(component: ComponentType<C>, config?: CsDrawerConfig<D>): CsDrawerRef<R, C>
  +closeAll(): void
}

class CsDrawerRef<R, C> {
  +componentInstance: C
  +closed: Observable<R | undefined>
  +backdropClick: Observable<MouseEvent>
  +close(result?: R): void
}

class CsDrawerHeaderDirective {
  +title: InputSignal<string>
  +showClose: InputSignal<boolean>
}

class CsDrawerFooterDirective {
  +align: InputSignal<CsDrawerFooterAlign>
}

enum CsDrawerFooterAlign {
  start
  end
  between
}

class FocusTrap <<CDK>> {
  +focusInitialElement(): boolean
  +destroy(): void
}

class BreakpointObserver <<CDK>> {
  +observe(query: string): Observable<BreakpointState>
}

CsDrawerComponent --> CsDrawerPosition : has
CsDrawerComponent --> CsDrawerMode : has
CsDrawerComponent *-- "0..1" FocusTrap : owns while modal
CsDrawerComponent ..> BreakpointObserver : reads
CsDrawerComponent o-- "0..1" CsDrawerHeaderDirective : projects
CsDrawerComponent o-- "0..1" CsDrawerFooterDirective : projects
CsDrawerContainerComponent o-- "1" CsDrawerComponent : reflows around
CsDrawerService ..> CsDrawerConfig : reads
CsDrawerService --> "0..*" CsDrawerRef : returns
CsDrawerService ..> CsDrawerComponent : attaches
CsDrawerConfig --> CsDrawerPosition : has
CsDrawerConfig --> CsDrawerMode : has
CsDrawerFooterDirective --> CsDrawerFooterAlign : has
CsDrawerRef ..> CsDrawerComponent : closes
@enduml
