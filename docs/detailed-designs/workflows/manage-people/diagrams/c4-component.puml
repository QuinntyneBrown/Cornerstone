@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Manage people

Person(admin, "Administrator", "Searches the directory and opens a record")

Container_Boundary(page, "Consuming application — feature page and services") {
  Component(directorysvc, "Directory service", "Angular injectable", "Owns querying, filtering, sorting, and the scope a viewer may see")
  Component(personsvc, "Person service", "Angular injectable", "Owns the person record, contact visibility, and persistence")
  Component(authz, "Authorization service", "Angular injectable", "Decides which people and which contact entries a viewer may see")
  Component(vmbuilder, "People view model builder", "Application code", "Projects scoped records into CsPersonRowView, CsPersonSummaryView, and CsRecordSection")
  Component(handler, "Intent handler", "Application code", "Receives CsPeopleQuery, CsPeopleSelectionChange, CsPersonRowAction, CsPersonOpen, and CsRecordSectionChange")
}

Container_Boundary(lib, "Cornerstone component library") {
  Component(directory, "CsPeopleDirectoryComponent", "Standalone component", "Renders search, filter, sort, selection, and the responsive table or list; applies no query itself")
  Component(row, "CsPersonRowComponent", "Standalone component", "Renders avatar, identity, role, cohort, status, and row actions; neither logs nor persists the personal data it renders")
  Component(summary, "CsPersonSummaryComponent", "Standalone component", "Renders the profile header with contact detail, status, and actions; neither logs nor persists the personal data it renders")
  Component(tabs, "CsRecordTabsComponent", "Standalone component", "Renders overview, progress, attendance, and history sections as an accessible tab set")
  Component(types, "People view model and intent types", "TypeScript types", "CsPersonRowView, CsPeopleQuery, CsPersonSummaryView, CsRecordSection, CsPersonOpen")
}

System_Ext(cdk, "Angular CDK", "Key manager and layout observer")

Rel(authz, directorysvc, "Scopes the result set of")
Rel(directorysvc, vmbuilder, "Supplies the scoped and ordered people to")
Rel(personsvc, vmbuilder, "Supplies the person record and visible contacts to")
Rel(vmbuilder, directory, "Supplies the row list and facets to", "CsPersonRowView[] input")
Rel(vmbuilder, summary, "Supplies the header view model to", "CsPersonSummaryView input")
Rel(vmbuilder, tabs, "Supplies the section list to", "CsRecordSection[] input")
Rel(directory, row, "Passes one person and the resolved variant to", "CsPersonRowView input")
Rel(row, directory, "Reports the row action and open request to", "outputs")
Rel(directory, handler, "Emits the query and selection intents to", "outputs")
Rel(summary, handler, "Emits the record action to", "CsPersonAction output")
Rel(tabs, handler, "Emits the section change to", "CsRecordSectionChange output")
Rel(handler, directorysvc, "Calls to re-query and re-order")
Rel(handler, personsvc, "Calls to load a record section")
Rel(directory, types, "Declares its input and output shapes in")
Rel(tabs, cdk, "Moves the active tab with")
Rel(directory, cdk, "Observes the viewport with")
Rel(admin, directory, "Types a search term in")
@enduml
