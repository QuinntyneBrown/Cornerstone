@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Take a quiz

Person(youth, "Youth participant", "Answers and submits")

Container_Boundary(page, "Consuming application — feature page and services") {
  Component(assessment, "Assessment service", "Angular injectable", "Owns the answer key, the pass threshold, and marking")
  Component(attempts, "Attempt service", "Angular injectable", "Persists answers and attempt lifecycle")
  Component(vmbuilder, "Quiz view model builder", "Application code", "Projects domain records into CsQuizView and CsQuizResultView")
  Component(handler, "Intent handler", "Application code", "Receives CsQuizAnswerChange, CsQuizNavigate, CsQuizSubmit, and CsQuizResultAction")
}

Container_Boundary(lib, "Cornerstone component library") {
  Component(quiz, "CsQuizComponent", "Standalone component", "Sequences questions, indicates progress, and runs the submit and confirm flow")
  Component(question, "CsQuizQuestionComponent", "Standalone component", "Renders single-choice, multiple-choice, and text answers; implements ControlValueAccessor")
  Component(result, "CsQuizResultComponent", "Standalone component", "Renders score, pass state, per-question feedback, explanations, and actions")
  Component(types, "Quiz view model and intent types", "TypeScript types", "CsQuizView, CsQuizQuestionView, CsQuizSubmit, CsQuizResultView, CsQuizResultAction")
  Component(styles, "Quiz styles", "Component-scoped CSS", "Resolve --cs- tokens for question, progress, and outcome surfaces")
}

System_Ext(cdk, "Angular CDK", "Overlay, focus trap, and key manager")

Rel(assessment, vmbuilder, "Supplies quiz definitions and marks to")
Rel(attempts, vmbuilder, "Supplies recorded answers to")
Rel(vmbuilder, quiz, "Supplies the attempt view model to", "CsQuizView input")
Rel(vmbuilder, result, "Supplies the marked view model to", "CsQuizResultView input")
Rel(quiz, question, "Passes one question and its recorded value to", "CsQuizQuestionView input")
Rel(question, quiz, "Reports the edited value to", "CsQuizAnswerChange output")
Rel(quiz, handler, "Emits the answer, navigation, and submit intents to", "outputs")
Rel(result, handler, "Emits the follow-on action to", "CsQuizResultAction output")
Rel(handler, attempts, "Calls to persist the attempt")
Rel(handler, assessment, "Calls to mark the attempt")
Rel(quiz, cdk, "Opens the confirm dialog with")
Rel(quiz, types, "Declares its input and output shapes in")
Rel(result, types, "Declares its input and output shapes in")
Rel(quiz, styles, "Renders with")
Rel(youth, question, "Enters an answer in")
@enduml
