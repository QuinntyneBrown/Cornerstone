{
  "name": "cornerstone-workspace",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "vite --config design-system/vite.config.ts",
    "start:docs": "vite --config design-system/vite.config.ts",
    "start:marketing": "vite marketing --port 5174",
    "build": "npm run build:library && npm run build:docs && npm run build:marketing",
    "build:library": "ng build cornerstone",
    "build:docs": "ngc -p design-system/tsconfig.app.json && vite build --config design-system/vite.config.ts",
    "build:marketing": "node scripts/build-marketing.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "schematics:test": "node scripts/test-schematics.mjs",
    "architecture:check": "node scripts/check-file-organization.mjs",
    "compile:apps": "ngc -p design-system/tsconfig.app.json",
    "api:generate": "node scripts/generate-api.mjs",
    "api:check": "node scripts/generate-api.mjs --check",
    "trace:check": "node scripts/check-traceability.mjs",
    "pack:check": "npm run build:library && node scripts/check-package.mjs",
    "size:check": "npm run build:library && node scripts/check-size.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.6.3",
    "@angular-devkit/schematics": "^21.2.19",
    "@angular/build": "^21.2.7",
    "@angular/cli": "^21.2.7",
    "@angular/compiler-cli": "^21.2.0",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@schematics/angular": "^21.2.19",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "angular-eslint": "^21.4.0",
    "axe-core": "^4.12.1",
    "eslint": "^10.7.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "prettier": "^3.8.1",
    "semantic-release": "^25.0.8",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.0.8"
  }
}
