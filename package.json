{
  "name": "cornerstone-workspace",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve design-system",
    "start:docs": "ng serve design-system",
    "start:marketing": "ng serve marketing",
    "build": "npm run build:library && npm run build:docs && npm run build:marketing",
    "build:library": "ng build cornerstone",
    "build:docs": "ng build design-system",
    "build:marketing": "ng build marketing",
    "watch": "ng build --watch --configuration development",
    "test": "ng test cornerstone --watch=false",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.7",
    "@angular/cli": "^21.2.7",
    "@angular/compiler-cli": "^21.2.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
